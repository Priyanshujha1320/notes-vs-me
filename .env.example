# Copy to .env (or export these) and fill in what you use.

# Hosted fallback — free key from https://console.groq.com
# (serves the same open-weight models, just on borrowed compute)
NVM_GROQ_API_KEY=

# Force a provider instead of auto-detection: "ollama" or "groq"
#NVM_PROVIDER=ollama

# Local model — gemma3:1b is the 8GB-laptop-safe default
#NVM_CHAT_MODEL=gemma3:1b

# Open model served by Groq for the hosted fallback
#NVM_GROQ_MODEL=llama-3.1-8b-instant
